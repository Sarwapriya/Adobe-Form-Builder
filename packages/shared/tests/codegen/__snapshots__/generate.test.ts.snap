<div class="form_check_group"><div class="form_check_module" id="Q1"><div class="form_check_title"><h3><span></span><span class="star">*</span></h3><p></p></div><div class="radio_group"><div class="radio_wrap"><input type="radio" id="Q1A1" name="Q1" value="A1" data-pt-api="y" data-parsley-error-message="Must select atleast one"><label for="Q1A1"><p></p></label></div><div class="radio_wrap"><input type="radio" id="Q1A2" name="Q1" value="A2" data-pt-api="y"><label for="Q1A2"><p></p></label></div></div></div><div class="form_check_module" id="Q2"><div class="form_check_title"><h3><span></span><span class="star">*</span></h3><p></p></div><div class="form_check_list_wrap"><div class="form_check_list"><input type="checkbox" id="Q2A1" name="Q2" value="A1" data-pt-api="y"><label for="Q2A1"><p></p></label></div><div class="form_check_list"><input type="checkbox" id="Q2A2" name="Q2" value="A2" data-pt-api="y"><label for="Q2A2"><p></p></label></div></div></div><div class="form_check_module" id="Q3"><div class="form_check_title"><h3><span></span></h3><p></p></div><div class="form_text_bx"><div class="input_wrap"><textarea id="Q3" name="Q3" rows="3" data-pt-api="y"></textarea></div></div></div><div class="form_bottom_group"><button class="disabled" disabled id="btnSubmit"></button><div class="error" id="apiError" style="display:none"></div></div></div>
</form>
</div>
</div>
