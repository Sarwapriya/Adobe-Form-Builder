# Python (FastAPI) port of backend/.env.example — see that file for the fuller
# explanatory comments this trims down; variable names are kept IDENTICAL so a
# single .env can (mostly) be shared/copied between the Node and Python backends
# during the migration.

# SQL Server connection string in mssql:// URL form, e.g.:
#   mssql://user:password@localhost:1433/WebFormBuilder
# Ignored when SQL_TRUSTED_CONNECTION=true.
SQL_CONNECTION_STRING=mssql://user:password@localhost:1433/WebFormBuilder

# "true" only for local dev against a self-signed-cert SQL Server instance —
# disables TLS certificate validation. Must stay unset/false in production.
SQL_TRUST_SERVER_CERTIFICATE=true

# --- Windows/trusted-connection auth (local dev only) ---
SQL_TRUSTED_CONNECTION=false
SQL_SERVER=localhost
SQL_INSTANCE=
SQL_DATABASE=Adobe-FC

# --- SMTP (fallback only; admin-configured settings take precedence — phase N) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- FabriXAI (fallback only; admin-configured settings take precedence — phase N) ---
FABRIX_API_BASE_URL=
FABRIX_MODEL_ID=
FABRIX_TIMEOUT_SECONDS=30
FABRIX_MAX_RETRIES=2
FABRIX_ENABLED=true
FABRIX_CLIENT_HEADER=
FABRIX_OPENAPI_TOKEN=
FABRIX_USER_EMAIL=

# --- AI chatbot LLM. The chatbot uses OpenAI: an enabled api.openai.com row in
# Configuration > AI Assistant > Other AI Providers, else OPENAI_* below. Groq
# (an api.groq.com row, else GROQ_*) is used only when no OpenAI key is set.
# `python scripts/set_openai_provider.py` copies OPENAI_* into that admin table.
# OpenRouter is never used by the chatbot. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENABLED=true

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ENABLED=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_ENABLED=true

# Pins the chatbot to exactly ONE provider, disabling the normal
# OpenAI-then-Groq auto-selection entirely — no automatic fallback, so
# switching to axhub-gemma4 never silently falls back to (and bills) an
# external API, and vice versa. Leave unset for today's unchanged behavior.
#   AI_PROVIDER=openai         # pin to OpenAI only, no Groq fallback
#   AI_PROVIDER=groq           # pin to Groq only, no OpenAI fallback
#   AI_PROVIDER=axhub-gemma4   # pin to the AX Hub controller below
AI_PROVIDER=

# --- AX Hub Gemma 4 (internal llama.cpp OpenAI-compatible server,
# ax-hub-ai.service) — only used when AI_PROVIDER=axhub-gemma4. Reached over
# the same ax-hub-net Docker network this backend/frontend already run on;
# never expose this port publicly. Verify the real URL/token requirement/
# model id against the actual controller before enabling. ---
AXHUB_AI_URL=http://172.20.0.1:18081
# Only sent as "Authorization: Bearer <token>" when non-empty.
AXHUB_AI_TOKEN=
AXHUB_MODEL=gemma-4-E2B
AXHUB_ENABLED=true

# --- DKMS (PII encryption/hashing for User.email/firstName/lastName) ---
# Fallback only — admin-configured settings (Configuration > DKMS, stored in
# AdminSettings) take precedence once set; see dkms_settings_service.py.
DKMS_BASE_URL=http://10.0.0.4:6161/dkms/v1
DKMS_TASK_ID=604:mena_dwf_task
DKMS_TIMEOUT_SECONDS=10
DKMS_PII_TAG_EMAIL=email
DKMS_PII_TAG_FIRST_NAME=name
DKMS_PII_TAG_LAST_NAME=name

# --- MCP-SQL (Model Context Protocol server the AI assistant chat calls to
# answer questions using live database data — see mcp_sql_client.py). No
# admin-UI config layer yet, env vars only.
# On the VM: point this at the container's internal Docker-network address,
# e.g. http://mcp-mssql:8000/mcp (same `formiq-net` network as the backend —
# no auth token needed for that path).
# Running the backend locally (outside that Docker network): use the public
# gateway route instead, e.g. http://ax-hub.samsung.com/mcp-mssql, and set
# MCP_SQL_AUTH_TOKEN to the bearer token that gateway route requires.
MCP_SQL_SERVER_URL=
MCP_SQL_AUTH_TOKEN=
MCP_SQL_ENABLED=true
MCP_SQL_TIMEOUT_SECONDS=30
# Only needed with AI_RETRIEVAL_SOURCE=mcp: the secret shared with the MCP
# server (same variable in its .env) that signs the signed-in user's identity
# for its FormIQ tools.
# Generate with: openssl rand -hex 32
MCP_USER_CONTEXT_SECRET=

# --- AI chatbot ---
# Where campaign retrieval runs: "direct" (default) reads this backend's own
# database (SQL_* above — crm-ax on the VM); "mcp" uses the MCP server's FormIQ
# tools instead (needs MCP_SQL_SERVER_URL + MCP_USER_CONTEXT_SECRET).
AI_RETRIEVAL_SOURCE=direct
# Max model <-> tool round trips per user message (local tool calling).
AI_MAX_TOOL_ROUNDS=6

FORMBUILDER_NOTIFY_EMAIL=

# SFTP deployment (phase N) is entirely admin-configured; no env-var fallback.

# Secret used to sign/verify JWTs (also used to derive the AES-256-GCM key for
# AdminSetting secret encryption). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Directory (relative or absolute) where uploaded files are stored. Created at startup.
UPLOAD_DIR=./uploads

# Exact origin of the frontend app allowed by CORS, e.g. https://formbuilder.example.com
FRONTEND_URL=

# Set to "production" when actually deployed — makes the refresh-token/CSRF
# cookies require HTTPS. Leave unset for local HTTP development.
NODE_ENV=

# SameSite attribute for the refresh-token/CSRF cookies. Leave unset (defaults
# to "strict") when the frontend and backend share a registrable domain. Set
# to "none" ONLY when they're on unrelated hosts/domains — e.g. an IP-based
# VM deployment where the frontend and backend are two separate
# hosts/ports/domains with no shared parent domain (see DEPLOYMENT.md §4).
# "none" requires NODE_ENV=production (HTTPS) or browsers reject the cookie.
COOKIE_SAMESITE=

# Must match the frontend's SUBPATH build arg (e.g. "/formiq") on a shared-hub
# deployment (see DEPLOYMENT.md's "Serving under a path prefix" section) —
# otherwise the refresh-token cookie's Path never matches the browser's real
# request URL and it's silently never sent back, breaking session refresh.
# Leave unset/empty for a root deployment.
SUBPATH=

# HTTP port for the backend server.
PORT=4001

# Comma-separated IP(s)/CIDR(s) of whatever sits directly in front of this
# container and terminates/forwards the real client connection — e.g. an
# Azure Application Gateway or Front Door's WAF v2 backend pool. Fed straight
# into uvicorn's own `--forwarded-allow-ips` (see the Dockerfile's CMD) so it
# trusts that specific hop's X-Forwarded-For/X-Forwarded-Proto and rewrites
# the request's client IP accordingly — which is what the rate limiter
# (app/middleware/rate_limit.py, keyed on the request's client IP) actually
# needs to see real per-user IPs instead of one shared proxy IP. Leave unset
# for uvicorn's own default (127.0.0.1 — i.e. nothing is trusted, today's
# unchanged behavior) until a specific proxy actually sits in front of this.
# Never set to a wildcard/"*" — that lets any client spoof its own IP via
# X-Forwarded-For.
TRUSTED_PROXY_IPS=

# --- One-time admin seed (phase N equivalent of backend/scripts/seedAdmin.ts) ---
ADMIN_USER=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
