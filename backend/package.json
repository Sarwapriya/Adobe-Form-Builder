{
  "name": "formbuilder-backend",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typeorm": "ts-node-dev --transpile-only ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "seed:admin": "ts-node-dev --transpile-only scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@formbuilder/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "deep-diff": "^1.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-jwt": "^8.4.1",
    "express-rate-limit": "^7.4.1",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "msnodesqlv8": "^5.2.3",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/deep-diff": "^1.0.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
