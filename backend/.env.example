# SQL Server connection string in mssql:// URL form, e.g.:
#   mssql://user:password@localhost:1433/WebFormBuilder                (local dev, SQL auth)
#   mssql://user:password@server.database.windows.net:1433/dbname      (Azure SQL)
# Ignored when SQL_TRUSTED_CONNECTION=true (see below).
SQL_CONNECTION_STRING=mssql://user:password@localhost:1433/WebFormBuilder

# Set to "true" only for local development against a SQL Server instance using a
# self-signed certificate (the default for most local installs) — this disables
# TLS certificate validation, so it must stay unset/false in production (e.g.
# against Azure SQL, which has a valid certificate).
SQL_TRUST_SERVER_CERTIFICATE=true

# --- Windows/trusted-connection auth (local dev only) ---
# Set to "true" to connect using the current Windows login instead of a SQL
# Server login (SQL_CONNECTION_STRING is then ignored). Requires the
# msnodesqlv8 native driver (installed as a backend dependency) and the
# "ODBC Driver 17 for SQL Server" ODBC driver on the machine running the backend.
SQL_TRUSTED_CONNECTION=false
# Hostname of the SQL Server machine, e.g. localhost or a computer name.
SQL_SERVER=localhost
# Named instance, e.g. SQLEXPRESS. Leave blank to connect to the default instance.
SQL_INSTANCE=
# Database name.
SQL_DATABASE=Adobe-FC

# --- SMTP (upload/submission notification emails) ---
# These are only the fallback — an admin can configure SMTP host/port/user/
# password/from directly from Configuration > Email / SMTP Settings, stored
# encrypted in the database (see smtpSettingsService.ts), which takes
# precedence over everything below when set.
# Hostname of your SMTP server, e.g. smtp.gmail.com, smtp.office365.com, or an
# internal relay. Email sending is skipped entirely (logged, never throws) if
# this is unset.
SMTP_HOST=
# 587 (STARTTLS) is the common default; 465 requires SMTP_SECURE=true.
SMTP_PORT=587
# Set to "true" only when connecting on port 465 (implicit TLS).
SMTP_SECURE=false
# SMTP auth credentials. Leave both blank only if your relay allows unauthenticated send.
SMTP_USER=
SMTP_PASSWORD=
# "From" address on outgoing mail. Falls back to SMTP_USER, then to the
# recipient address itself, if unset. Many providers reject mail unless this
# matches (or is a verified alias of) the authenticated SMTP_USER.
SMTP_FROM=

# --- FabriXAI (AI Form Builder Assistant) ---
# These are only the fallback — an admin can configure all of this directly
# from Configuration > AI Assistant Settings, stored (secrets encrypted) in
# the database (see fabrixSettingsService.ts), which takes precedence over
# everything below when set.
# Base URL of the FabriX OpenAPI gateway, e.g. https://your-tenant.fabrix-s.samsungsds.com/sds/trial/api-chat
# — the assistant calls POST {this}/openapi/chat/v1/messages. FabriX is
# unusable until this is set (here or via the admin UI) and at least one
# model is enabled in Configuration > AI Assistant > Models.
FABRIX_API_BASE_URL=
# Last-resort single-model fallback, only used if the FabrixModels DB table
# (Configuration > AI Assistant > Models) has zero enabled rows.
FABRIX_MODEL_ID=
# Per-request timeout before the call is aborted and retried.
FABRIX_TIMEOUT_SECONDS=30
# Number of retries on timeout/5xx/network error, with capped exponential backoff.
FABRIX_MAX_RETRIES=2
# Set to "false" to disable the assistant outright without clearing the other values.
FABRIX_ENABLED=true
# Required auth headers for the FabriX OpenAPI endpoint — x-fabrix-client and
# x-openapi-token (see fabrixAIService.ts's callFabrixAgent doc comment for
# the exact contract). Never commit real values here; use the local
# backend/.env (gitignored) or Configuration > AI Assistant Settings instead.
FABRIX_CLIENT_HEADER=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJjbGllbnRJZCI6IjIyM2M3MGFkLWQwNTctNGQ4MC1iM2U4LTNlMzc3MDdkMWQwYy0yNDY4IiwiY2xpZW50U2VjcmV0IjoidkpGMlFQcTdkaExHVW9NWkFNazVlTjRrcm1JanoyNE4iLCJleHAiOjE3OTAzNDgzOTl9.zcmeYjEimc8uQ8rjK3tmZJfm9i8mrEtwIGvg2_G7_xE
FABRIX_OPENAPI_TOKEN=Bearer ..X7iB7yH6UtNgdlrE627Q78FKdpAL8I6CZAOWwWlix0nhzljB6ogeu-D1S3o157zRofslZbCGAJxrrbMd3Ei0jVtvZSWfs0TCjBSe_F_3y4TyYQLhRLV825eZfdza4zUC1B6k__-HKpQeuim3G2Vsd3KzlSPTRgdrXsoJpgMOYeBYIYJNQJu9TZJrCX0pIlaeBJJltvqIVNt5OXY6pPNFKC_ZyG9Skeo7KEe9J_oR08lrymlJrv_N2dLvfJIj205TgHemUa1jW-wXFmWj0EP6Hp1jB-HbYKAzltBhM0iZflqFU0uo_R5Gud9WRrUc4QIMt3Gso4l5105PJp9Mf7XZ8A
# Optional x-generative-ai-user-email header (portal user tracking).
FABRIX_USER_EMAIL=janitha.sg@samsung.com

# --- Claude (second AI Assistant provider, alongside FabriX) ---
# Which backend the AI Assistant chat panel actually calls — "fabrix" or
# "claude". Only a fallback; an admin switches this live from
# Configuration > AI Assistant > Active AI Provider.
AI_PROVIDER=fabrix
# Anthropic API key — see console.anthropic.com. Only a fallback; can be set
# (encrypted) from Configuration > AI Assistant > Claude Settings instead.
ANTHROPIC_API_KEY=
# e.g. claude-opus-5, claude-sonnet-5, claude-haiku-4-5.
CLAUDE_MODEL=claude-opus-5
CLAUDE_ENABLED=true

# Notification recipient. If unset, falls back to AdminSettings.notificationEmail in the DB.
FORMBUILDER_NOTIFY_EMAIL=janitha.sg@samsung.com

# SFTP deployment (Adobe Campaign drop folder) is configured entirely from
# Configuration > Deployment (staging/production host, port, username, local
# private-key path, remote path — see sftpSettingsService.ts), stored in the
# database. There is no env-var fallback for it.

# Secret used to sign/verify JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Directory (relative or absolute) where uploaded Excel files are stored. Created at startup.
UPLOAD_DIR=./uploads

# Exact origin of the frontend app allowed by CORS, e.g. https://formbuilder.example.com
FRONTEND_URL=

# Set to "production" when actually deployed — this makes the refresh-token cookie
# require HTTPS (see routes/auth.router.ts). Leave unset for local HTTP development.
NODE_ENV=

# HTTP port for the backend server.
PORT=4000

# --- One-time admin seed (backend/scripts/seedAdmin.ts, run via `npm run seed:admin`) ---
# These are ONLY read by that one-time script — login no longer checks them
# directly, it looks up real rows in the Users table (see services/authService.ts).
ADMIN_USER=janitha
ADMIN_EMAIL=janitha.sg@samsung.com
# bcrypt hash of the admin password. Generate with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=p@$$w0rd
